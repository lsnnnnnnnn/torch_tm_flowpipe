{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archcomp26-instance-contract-v1",
  "title": "ARCH-COMP26 resolved instance contract",
  "description": "Shared mathematical contract for one benchmark instance. Method-specific arithmetic, runtime, command, source, and binary fields remain in the execution matrix cell.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance_id", "profile", "fields", "evidence"],
  "properties": {
    "schema_version": {"const": "archcomp26-instance-contract-v1"},
    "instance_id": {"type": "string", "minLength": 1},
    "profile": {
      "enum": ["full_execution_contract_v1", "discrete_execution_contract_v1"]
    },
    "fields": {"type": "object"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "supports"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "supports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
