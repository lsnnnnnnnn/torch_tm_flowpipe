diff --git a/tests/test_flowstar_step_trace_compare_alignment.py b/tests/test_flowstar_step_trace_compare_alignment.py
index 7267072..30e1bc4 100644
--- a/tests/test_flowstar_step_trace_compare_alignment.py
+++ b/tests/test_flowstar_step_trace_compare_alignment.py
@@ -112,6 +112,35 @@ def test_missing_fields_mark_unknown_not_zero():
     assert rows[0]["right_map_width_ratio_noqueue_over_flowstar"] is None
 
 
+def test_flowstar_probe_command_forwards_order_without_segment_limit(tmp_path, monkeypatch):
+    calls: list[list[str]] = []
+
+    def fake_run(cmd, **_kwargs):
+        calls.append(cmd)
+        return subprocess.CompletedProcess(cmd, 0, stdout="", stderr="")
+
+    monkeypatch.setattr(compare.subprocess, "run", fake_run)
+
+    trace = compare.run_flowstar_probe(
+        tmp_path / "probe",
+        tmp_path,
+        horizon=0.1,
+        max_segments=None,
+        order=2,
+    )
+
+    assert trace == tmp_path / "flowstar_trace.csv"
+    assert calls == [
+        [
+            str(tmp_path / "probe"),
+            str(trace),
+            "0.10000000000000001",
+            "0",
+            "2",
+        ]
+    ]
+
+
 def _write_csv(path: Path, rows: list[dict[str, object]]) -> None:
     fields = sorted({field for row in rows for field in row})
     path.parent.mkdir(parents=True, exist_ok=True)
