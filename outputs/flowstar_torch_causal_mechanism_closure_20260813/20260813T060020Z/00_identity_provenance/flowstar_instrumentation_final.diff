+#ifdef FLOWSTAR_CAUSAL_AUDIT_ACCESS
+std::string Real::auditCanonicalBinary() const
+{
+	if(!mpfr_number_p(value))
+	{
+		return "";
+	}
+	mpz_t mantissa;
+	mpz_init(mantissa);
+	mpfr_exp_t exponent = mpfr_get_z_2exp(mantissa, value);
+	const int sign = mpfr_signbit(value) ? -1 : 1;
+	if(mpz_sgn(mantissa) < 0)
+	{
+		mpz_neg(mantissa, mantissa);
+	}
+	char * digits = mpz_get_str(NULL, 16, mantissa);
+	std::ostringstream stream;
+	stream << mpfr_get_prec(value) << ':' << sign << ':' << digits << ':' << exponent;
+	void (*free_function)(void *, size_t);
+	mp_get_memory_functions(NULL, NULL, &free_function);
+	free_function(digits, std::strlen(digits) + 1);
+	mpz_clear(mantissa);
+	return stream.str();
+}
+
+bool Real::auditSetCanonicalBinary(const std::string & canonical)
+{
+	std::vector<std::string> fields;
+	std::string current;
+	for(size_t i=0; i<=canonical.size(); ++i)
+	{
+		if(i == canonical.size() || canonical[i] == ':')
+		{
+			fields.push_back(current);
+			current.clear();
+		}
+		else
+		{
+			current.push_back(canonical[i]);
+		}
+	}
+	if(fields.size() != 4 || fields[0].empty() || fields[1].empty() || fields[2].empty() || fields[3].empty())
+	{
+		return false;
+	}
+	char * end = NULL;
+	unsigned long precision = std::strtoul(fields[0].c_str(), &end, 10);
+	if(*end != '\0' || precision < MPFR_PREC_MIN || precision > MPFR_PREC_MAX)
+	{
+		return false;
+	}
+	long sign = std::strtol(fields[1].c_str(), &end, 10);
+	if(*end != '\0' || (sign != -1 && sign != 1))
+	{
+		return false;
+	}
+	long exponent = std::strtol(fields[3].c_str(), &end, 10);
+	if(*end != '\0')
+	{
+		return false;
+	}
+	mpz_t mantissa;
+	mpz_init(mantissa);
+	if(mpz_set_str(mantissa, fields[2].c_str(), 16) != 0 || mpz_sgn(mantissa) < 0)
+	{
+		mpz_clear(mantissa);
+		return false;
+	}
+	mpfr_set_prec(value, static_cast<mpfr_prec_t>(precision));
+	if(mpz_sgn(mantissa) == 0)
+	{
+		mpfr_set_zero(value, sign < 0 ? -1 : 1);
+	}
+	else
+	{
+		if(sign < 0)
+		{
+			mpz_neg(mantissa, mantissa);
+		}
+		if(mpfr_set_z_2exp(value, mantissa, static_cast<mpfr_exp_t>(exponent), MPFR_RNDN) != 0)
+		{
+			mpz_clear(mantissa);
+			return false;
+		}
+	}
+	mpz_clear(mantissa);
+	return auditCanonicalBinary() == canonical;
+}
