diff --git a/flowstar-toolbox/CausalTrace.h b/flowstar-toolbox/CausalTrace.h
new file mode 100644
index 0000000..3a2f724
--- /dev/null
+++ b/flowstar-toolbox/CausalTrace.h
@@ -0,0 +1,453 @@
+#ifndef FLOWSTAR_CAUSAL_TRACE_H_
+#define FLOWSTAR_CAUSAL_TRACE_H_
+
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <limits>
+#include <list>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace flowstar_causal
+{
+
+struct Context
+{
+	int accepted_step_index;
+	int retry_index;
+	long attempt_index;
+	int picard_iteration;
+	int refinement_iteration;
+	double t_pre;
+	double scheduler_loop_t;
+	double h_attempt;
+	Context() : accepted_step_index(-1), retry_index(-1), attempt_index(-1),
+		picard_iteration(-1), refinement_iteration(-1), t_pre(0), scheduler_loop_t(0), h_attempt(0) {}
+};
+
+inline Context & context()
+{
+	static Context value;
+	return value;
+}
+
+inline const char * trace_path()
+{
+	return std::getenv("FLOWSTAR_CAUSAL_TRACE");
+}
+
+inline bool enabled()
+{
+	const char *path = trace_path();
+	return path != NULL && path[0] != '\0';
+}
+
+inline int target_step()
+{
+	const char *value = std::getenv("FLOWSTAR_CAUSAL_ACCEPTED_STEP");
+	return value == NULL ? -1 : static_cast<int>(std::strtol(value, NULL, 10));
+}
+
+inline bool active()
+{
+	return enabled() && (target_step() < 0 || context().accepted_step_index == target_step());
+}
+
+inline const char * replay_candidate_path()
+{
+	return std::getenv("FLOWSTAR_CAUSAL_REPLAY_CANDIDATE");
+}
+
+inline const char * replay_endpoint_path()
+{
+	return std::getenv("FLOWSTAR_CAUSAL_REPLAY_ENDPOINT");
+}
+
+inline std::string escaped(const std::string &value)
+{
+	std::ostringstream out;
+	for(std::string::const_iterator it = value.begin(); it != value.end(); ++it)
+	{
+		switch(*it)
+		{
+		case '\\': out << "\\\\"; break;
+		case '"': out << "\\\""; break;
+		case '\n': out << "\\n"; break;
+		case '\r': out << "\\r"; break;
+		case '\t': out << "\\t"; break;
+		default: out << *it;
+		}
+	}
+	return out.str();
+}
+
+inline std::string quoted(const std::string &value)
+{
+	return std::string("\"") + escaped(value) + "\"";
+}
+
+inline std::string number(const double value)
+{
+	std::ostringstream decimal, hex;
+	decimal << std::setprecision(std::numeric_limits<double>::max_digits10) << value;
+	hex << std::hexfloat << value;
+	return std::string("{\"decimal\":") + quoted(decimal.str()) + ",\"hex\":" + quoted(hex.str()) + "}";
+}
+
+inline std::string interval(const flowstar::Interval &value)
+{
+	return std::string("{\"lower\":") + number(value.inf()) + ",\"upper\":" + number(value.sup()) + "}";
+}
+
+inline std::string base(const std::string &record_type, const std::string &stage, const int component)
+{
+	const char *run = std::getenv("FLOWSTAR_CAUSAL_RUN_ID");
+	const char *commit = std::getenv("FLOWSTAR_CAUSAL_SOURCE_COMMIT");
+	const Context &ctx = context();
+	std::ostringstream out;
+	out << "{\"schema\":\"flowstar_causal_observer_v1\""
+		<< ",\"record_type\":" << quoted(record_type)
+		<< ",\"tool\":\"flowstar\""
+		<< ",\"source_commit\":" << quoted(commit == NULL ? "unknown" : commit)
+		<< ",\"run_id\":" << quoted(run == NULL ? "flowstar-causal-observation" : run)
+		<< ",\"accepted_step_index\":" << ctx.accepted_step_index
+		<< ",\"attempt_index\":" << ctx.attempt_index
+		<< ",\"retry_index\":" << ctx.retry_index
+		<< ",\"picard_iteration\":" << ctx.picard_iteration
+		<< ",\"refinement_iteration\":" << ctx.refinement_iteration
+		<< ",\"t_pre\":" << number(ctx.t_pre)
+		<< ",\"scheduler_loop_t\":" << number(ctx.scheduler_loop_t)
+		<< ",\"h_attempt\":" << number(ctx.h_attempt)
+		<< ",\"component\":" << component
+		<< ",\"stage\":" << quoted(stage);
+	return out.str();
+}
+
+inline void write(const std::string &line)
+{
+	if(!active()) return;
+	std::ofstream out(trace_path(), std::ios::out | std::ios::app);
+	out << line << "\n";
+}
+
+inline void set_step_context(const int accepted_step_index, const double physical_t_pre, const double scheduler_loop_t)
+{
+	if(!enabled()) return;
+	Context &ctx = context();
+	ctx.accepted_step_index = accepted_step_index;
+	ctx.retry_index = -1;
+	ctx.picard_iteration = -1;
+	ctx.refinement_iteration = -1;
+	ctx.t_pre = physical_t_pre;
+	ctx.scheduler_loop_t = scheduler_loop_t;
+	ctx.h_attempt = 0;
+}
+
+inline void begin_candidate(const double h_attempt)
+{
+	if(!active()) return;
+	Context &ctx = context();
+	++ctx.retry_index;
+	++ctx.attempt_index;
+	ctx.h_attempt = h_attempt;
+	ctx.picard_iteration = -1;
+	ctx.refinement_iteration = -1;
+}
+
+inline void set_picard_iteration(const int value)
+{
+	if(active()) context().picard_iteration = value;
+}
+
+inline void set_refinement_iteration(const int value)
+{
+	if(active()) context().refinement_iteration = value;
+}
+
+inline void emit_event(const std::string &stage, const bool accepted, const std::string &note)
+{
+	if(!active()) return;
+	write(base("event", stage, -1) + ",\"accepted\":" + (accepted ? "true" : "false")
+		+ ",\"note\":" + quoted(note) + "}");
+}
+
+inline void coefficient_bounds(const flowstar::Real &value, double &lo, double &hi)
+{
+	lo = value.getValue_RNDD();
+	hi = value.getValue_RNDU();
+}
+
+inline void coefficient_bounds(const flowstar::Interval &value, double &lo, double &hi)
+{
+	lo = value.inf();
+	hi = value.sup();
+}
+
+template <class DATA_TYPE>
+inline void emit_polynomial(const std::string &stage, const int component,
+	const flowstar::Polynomial<DATA_TYPE> &polynomial)
+{
+	if(!active()) return;
+	write(base("polynomial_meta", stage, component) + ",\"support_size\":"
+		+ number(static_cast<double>(polynomial.terms.size())) + "}");
+	int term_index = 0;
+	for(typename std::list<flowstar::Term<DATA_TYPE> >::const_iterator term = polynomial.terms.begin();
+		term != polynomial.terms.end(); ++term, ++term_index)
+	{
+		double lo = 0, hi = 0;
+		coefficient_bounds(term->causalAuditCoefficient(), lo, hi);
+		std::ostringstream degrees;
+		degrees << "[";
+		const std::vector<unsigned int> &items = term->causalAuditDegrees();
+		for(unsigned int i=0; i<items.size(); ++i)
+		{
+			if(i > 0) degrees << ",";
+			degrees << items[i];
+		}
+		degrees << "]";
+		std::ostringstream out;
+		out << base("polynomial_term", stage, component)
+			<< ",\"term_index\":" << term_index
+			<< ",\"exponents\":" << degrees.str()
+			<< ",\"coefficient_lower\":" << number(lo)
+			<< ",\"coefficient_upper\":" << number(hi) << "}";
+		write(out.str());
+	}
+}
+
+template <class DATA_TYPE>
+inline void emit_tmv(const std::string &stage, const flowstar::TaylorModelVec<DATA_TYPE> &tmv)
+{
+	if(!active()) return;
+	for(unsigned int component=0; component<tmv.tms.size(); ++component)
+	{
+		write(base("taylor_model", stage, static_cast<int>(component))
+			+ ",\"remainder\":" + interval(tmv.tms[component].remainder) + "}");
+		emit_polynomial(stage, static_cast<int>(component), tmv.tms[component].expansion);
+	}
+}
+
+inline void emit_real_vector(const std::string &stage, const std::vector<flowstar::Real> &values)
+{
+	if(!active()) return;
+	for(unsigned int i=0; i<values.size(); ++i)
+	{
+		double lo = 0, hi = 0;
+		coefficient_bounds(values[i], lo, hi);
+		write(base("real_vector_entry", stage, static_cast<int>(i))
+			+ ",\"lower\":" + number(lo) + ",\"upper\":" + number(hi) + "}");
+	}
+}
+
+inline void emit_interval_vector(const std::string &stage, const std::vector<flowstar::Interval> &values)
+{
+	if(!active()) return;
+	for(unsigned int i=0; i<values.size(); ++i)
+	{
+		write(base("interval_vector_entry", stage, static_cast<int>(i))
+			+ ",\"interval\":" + interval(values[i]) + "}");
+	}
+}
+
+inline void emit_interval_list(const std::string &stage, const std::list<flowstar::Interval> &values)
+{
+	if(!active()) return;
+	int i = 0;
+	for(std::list<flowstar::Interval>::const_iterator it=values.begin(); it!=values.end(); ++it, ++i)
+	{
+		write(base("interval_list_entry", stage, i) + ",\"interval\":" + interval(*it) + "}");
+	}
+}
+
+template <class DATA_TYPE>
+inline void emit_matrix(const std::string &stage, const int queue_index,
+	const flowstar::Matrix<DATA_TYPE> &input)
+{
+	if(!active()) return;
+	flowstar::Matrix<DATA_TYPE> value(input);
+	for(unsigned int row=0; row<value.rows(); ++row)
+	{
+		for(unsigned int col=0; col<value.cols(); ++col)
+		{
+			double lo = 0, hi = 0;
+			coefficient_bounds(value[row][col], lo, hi);
+			std::ostringstream out;
+			out << base("matrix_entry", stage, static_cast<int>(row))
+				<< ",\"queue_index\":" << queue_index << ",\"row\":" << row << ",\"col\":" << col
+				<< ",\"lower\":" << number(lo) << ",\"upper\":" << number(hi) << "}";
+			write(out.str());
+		}
+	}
+}
+
+template <class SYMBOLIC_REMAINDER>
+inline void emit_symbolic(const std::string &stage, const SYMBOLIC_REMAINDER &symbolic)
+{
+	if(!active()) return;
+	std::ostringstream meta;
+	meta << base("symbolic_queue", stage, -1)
+		<< ",\"j_size\":" << symbolic.J.size()
+		<< ",\"phi_size\":" << symbolic.Phi_L.size()
+		<< ",\"max_size\":" << symbolic.max_size << "}";
+	write(meta.str());
+	emit_real_vector(stage + ":scalars", symbolic.scalars);
+	for(unsigned int i=0; i<symbolic.J.size(); ++i) emit_matrix(stage + ":J", static_cast<int>(i), symbolic.J[i]);
+	for(unsigned int i=0; i<symbolic.Phi_L.size(); ++i) emit_matrix(stage + ":Phi_L", static_cast<int>(i), symbolic.Phi_L[i]);
+}
+
+inline void emit_subset_component(const std::string &stage, const int component,
+	const flowstar::Interval &image, const flowstar::Interval &target, const bool accepted)
+{
+	if(!active()) return;
+	double lower_margin = image.inf() - target.inf();
+	double upper_margin = target.sup() - image.sup();
+	double margin = lower_margin < upper_margin ? lower_margin : upper_margin;
+	write(base("subset_test", stage, component)
+		+ ",\"image\":" + interval(image)
+		+ ",\"target\":" + interval(target)
+		+ ",\"lower_margin\":" + number(lower_margin)
+		+ ",\"upper_margin\":" + number(upper_margin)
+		+ ",\"minimum_margin\":" + number(margin)
+		+ ",\"accepted\":" + (accepted ? "true" : "false") + "}");
+}
+
+// Deliberately separate from the observation path: this is enabled only for a
+// named counterfactual replay and is never consulted by ordinary logged or
+// unlogged executions.  Input rows are:
+//   component coefficient degree_tau degree_r0 ... degree_rN
+inline bool replace_candidate_for_replay(flowstar::TaylorModelVec<flowstar::Real> &candidate)
+{
+	const char *path = replay_candidate_path();
+	if(path == NULL || path[0] == '\0') return false;
+	if(target_step() >= 0 && context().accepted_step_index != target_step()) return false;
+	std::ifstream input(path);
+	if(!input)
+	{
+		emit_event("counterfactual_candidate_load_failed", false, "could not open replay input");
+		return false;
+	}
+	std::vector<flowstar::Polynomial<flowstar::Real> > replacements(candidate.tms.size());
+	std::vector<bool> selected(candidate.tms.size(), false);
+	std::string line;
+	unsigned int rows = 0;
+	while(std::getline(input, line))
+	{
+		if(line.empty() || line[0] == '#') continue;
+		std::istringstream row(line);
+		int component = -1;
+		double coefficient = 0;
+		row >> component >> coefficient;
+		if(!row || component < 0 || static_cast<unsigned int>(component) >= candidate.tms.size())
+		{
+			emit_event("counterfactual_candidate_load_failed", false, "malformed replay row");
+			return false;
+		}
+		std::vector<unsigned int> degrees;
+		unsigned int degree = 0;
+		while(row >> degree) degrees.push_back(degree);
+		if(degrees.empty())
+		{
+			emit_event("counterfactual_candidate_load_failed", false, "replay row has no exponents");
+			return false;
+		}
+		replacements[component].terms.push_back(
+			flowstar::Term<flowstar::Real>::causalReplayTerm(flowstar::Real(coefficient), degrees));
+		selected[component] = true;
+		++rows;
+	}
+	for(unsigned int component=0; component<candidate.tms.size(); ++component)
+	{
+		if(!selected[component]) continue;
+		replacements[component].reorder();
+		candidate.tms[component].expansion = replacements[component];
+	}
+	std::ostringstream note;
+	note << "replaced candidate polynomial from external common-basis replay; rows=" << rows;
+	emit_event("counterfactual_candidate_replaced", true, note.str());
+	return true;
+}
+
+inline bool replace_endpoint_for_replay(flowstar::TaylorModelVec<flowstar::Real> &endpoint)
+{
+	const char *path = replay_endpoint_path();
+	if(path == NULL || path[0] == '\0') return false;
+	if(target_step() >= 0 && context().accepted_step_index != target_step()) return false;
+	std::ifstream input(path);
+	if(!input)
+	{
+		emit_event("counterfactual_endpoint_load_failed", false, "could not open replay input");
+		return false;
+	}
+	std::vector<flowstar::Polynomial<flowstar::Real> > replacements(endpoint.tms.size());
+	std::vector<flowstar::Interval> remainders(endpoint.tms.size());
+	std::vector<bool> selected(endpoint.tms.size(), false), has_remainder(endpoint.tms.size(), false);
+	std::string line;
+	unsigned int rows = 0;
+	while(std::getline(input, line))
+	{
+		if(line.empty() || line[0] == '#') continue;
+		std::istringstream row(line);
+		char kind = '\0';
+		int component = -1;
+		row >> kind >> component;
+		if(!row || component < 0 || static_cast<unsigned int>(component) >= endpoint.tms.size())
+		{
+			emit_event("counterfactual_endpoint_load_failed", false, "malformed replay row");
+			return false;
+		}
+		if(kind == 'R')
+		{
+			double lo = 0, hi = 0;
+			row >> lo >> hi;
+			if(!row || lo > hi)
+			{
+				emit_event("counterfactual_endpoint_load_failed", false, "malformed remainder row");
+				return false;
+			}
+			remainders[component] = flowstar::Interval(lo, hi);
+			has_remainder[component] = true;
+			continue;
+		}
+		if(kind != 'T')
+		{
+			emit_event("counterfactual_endpoint_load_failed", false, "unknown replay row kind");
+			return false;
+		}
+		double coefficient = 0;
+		row >> coefficient;
+		std::vector<unsigned int> degrees;
+		unsigned int degree = 0;
+		while(row >> degree) degrees.push_back(degree);
+		if(degrees.empty())
+		{
+			emit_event("counterfactual_endpoint_load_failed", false, "term row has no exponents");
+			return false;
+		}
+		replacements[component].terms.push_back(
+			flowstar::Term<flowstar::Real>::causalReplayTerm(flowstar::Real(coefficient), degrees));
+		selected[component] = true;
+		++rows;
+	}
+	for(unsigned int component=0; component<endpoint.tms.size(); ++component)
+	{
+		if(!selected[component]) continue;
+		if(!has_remainder[component])
+		{
+			emit_event("counterfactual_endpoint_load_failed", false, "selected component has no remainder");
+			return false;
+		}
+		replacements[component].reorder();
+		endpoint.tms[component].expansion = replacements[component];
+		endpoint.tms[component].remainder = remainders[component];
+	}
+	std::ostringstream note;
+	note << "replaced endpoint from external common-basis replay; polynomial_rows=" << rows;
+	emit_event("counterfactual_endpoint_replaced", true, note.str());
+	return true;
+}
