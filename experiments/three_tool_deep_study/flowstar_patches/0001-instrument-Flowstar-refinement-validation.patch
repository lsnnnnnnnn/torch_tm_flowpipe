+				"uncertainty_contribution=embedded_in_picard_remainder "
+				"separately_exposed=0 source_line=%d\n",
+				flowstar_audit_step(), i, __LINE__);
+		}
+		flowstar_audit_interval(
+			"first_picard_image_remainder_with_int_difference", i,
+			tmvTmp.tms[i].remainder, -1, subset ? 1 : 0, __LINE__);
+
+		if(!subset)
 		{
 			bfound = false;
+			if(flowstar_audit_trace_enabled())
+			{
+				printf(
+					"FLOWSTAR_AUDIT step=%s phase=advance_return "
+					"reason=first_picard_inclusion_failed failing_state=%u "
+					"return_code=0 source_line=%d\n",
+					flowstar_audit_step(), i, __LINE__);
+			}
 			break;
 		}
 	}
@@ -1002,11 +1132,25 @@ int Flowpipe::advance(Flowpipe & result, const std::vector<Expression<Real> > &
 		for(unsigned int i=0; i<rangeDim; ++i)
 		{
 			x.tms[i].remainder = tmvTmp.tms[i].remainder;
+			accepted_initial_remainders.push_back(x.tms[i].remainder);
+			flowstar_audit_interval(
+				"accepted_initial_remainder", i,
+				x.tms[i].remainder, -1, 1, __LINE__);
 		}
 	}
 
 	bool bfinished = false;
-	for(int rSteps = 0; !bfinished && (rSteps <= MAX_REFINEMENT_STEPS); ++rSteps)
+	const bool disable_refinement = flowstar_audit_no_refinement();
+	if(disable_refinement && flowstar_audit_trace_enabled())
+	{
+		printf(
+			"FLOWSTAR_AUDIT step=%s phase=refinement_disabled "
