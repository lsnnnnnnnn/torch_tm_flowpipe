+		flowstar_audit_interval(
+			"polynomial_difference_interval", i, I, -1, -1, __LINE__);
 	}
 
 	// add the uncertainties and the cutoff intervals onto the result
@@ -986,9 +1081,44 @@ int Flowpipe::advance(Flowpipe & result, const std::vector<Expression<Real> > &
 	{
 		tmvTmp.tms[i].remainder += intDifferences[i];
 
