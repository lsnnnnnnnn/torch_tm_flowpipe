+			if(flowstar_audit_trace_enabled())
+			{
+				printf(
+					"FLOWSTAR_AUDIT step=%s phase=refinement_decision "
+					"state=%u round=%d subset=%d width_ratio=%.17g "
+					"stop_ratio=%.17g continue=%d source_line=%d\n",
+					flowstar_audit_step(), i, rSteps, subset ? 1 : 0,
+					width_ratio, (double)STOP_RATIO,
+					(subset && width_ratio <= STOP_RATIO) ? 1 : 0,
