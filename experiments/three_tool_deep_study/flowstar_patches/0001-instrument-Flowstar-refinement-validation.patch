+		}
+	}
+
 	bool bfound = true;
+	std::vector<Interval> accepted_initial_remainders;
 
 	for(unsigned int i=0; i<rangeDim; ++i)
 	{
@@ -979,6 +1069,11 @@ int Flowpipe::advance(Flowpipe & result, const std::vector<Expression<Real> > &
