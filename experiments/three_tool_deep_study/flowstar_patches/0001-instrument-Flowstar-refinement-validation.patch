 #include "Continuous.h"
+#include <cstdlib>
 
 using namespace flowstar;
 
+namespace
+{
+bool flowstar_audit_trace_enabled()
+{
+	const char * value = std::getenv("FLOWSTAR_AUDIT_TRACE");
+	return value != NULL && value[0] != '\0' && value[0] != '0';
+}
+
+bool flowstar_audit_no_refinement()
+{
+	const char * value = std::getenv("FLOWSTAR_AUDIT_DISABLE_REFINEMENT");
+	return value != NULL && value[0] != '\0' && value[0] != '0';
+}
+
+bool flowstar_audit_revalidate_refinement()
+{
+	const char * value = std::getenv("FLOWSTAR_AUDIT_REVALIDATE_REFINEMENT");
+	return value != NULL && value[0] != '\0' && value[0] != '0';
+}
+
+const char * flowstar_audit_step()
+{
+	const char * value = std::getenv("FLOWSTAR_AUDIT_STEP");
+	return value == NULL ? "unknown" : value;
+}
+
+void flowstar_audit_interval(
+	const char * phase,
+	const unsigned int state,
+	const Interval & value,
+	const int refinement_round,
+	const int subset_result,
+	const int source_line)
+{
+	if(!flowstar_audit_trace_enabled())
+		return;
+
+	printf(
+		"FLOWSTAR_AUDIT step=%s phase=%s state=%u round=%d "
+		"lower=%.17g upper=%.17g width=%.17g subset=%d source_line=%d\n",
+		flowstar_audit_step(), phase, state, refinement_round,
+		value.inf(), value.sup(), value.sup() - value.inf(),
+		subset_result, source_line);
+}
+}
+
 
 
 Symbolic_Remainder::Symbolic_Remainder()
