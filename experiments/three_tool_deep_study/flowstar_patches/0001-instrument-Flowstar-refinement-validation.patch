+			}
+
+			if(subset)
+			{
+				if(width_ratio <= STOP_RATIO)
 				{
 					bfinished = false;
 				}
@@ -1035,9 +1200,69 @@ int Flowpipe::advance(Flowpipe & result, const std::vector<Expression<Real> > &
 		}
 	}
 
+	if(flowstar_audit_revalidate_refinement() && !disable_refinement)
+	{
+		TaylorModelVec<Interval> revalidatedPicard;
+		std::list<Interval> revalidatedIntermediateRanges;
+		x.Picard_ctrunc_normal(
+			revalidatedPicard, new_x0, ode, tm_setting.step_exp_table,
+			rangeDimExt, tm_setting.order, tm_setting.cutoff_threshold,
+			revalidatedIntermediateRanges, g_setting);
+
+		bool refinedVectorValidated = true;
+		for(unsigned int i=0; i<rangeDim; ++i)
+		{
+			Polynomial<Interval> refinedDifference;
+			refinedDifference =
+				revalidatedPicard.tms[i].expansion - x.tms[i].expansion;
+			Interval refinedIntDifference;
+			refinedDifference.intEvalNormal(
+				refinedIntDifference, tm_setting.step_exp_table);
+			revalidatedPicard.tms[i].remainder += refinedIntDifference;
+			const bool subset = revalidatedPicard.tms[i].remainder.subseteq(
+				x.tms[i].remainder);
+			flowstar_audit_interval(
+				"refined_full_picard_revalidation_image", i,
+				revalidatedPicard.tms[i].remainder, -1,
+				subset ? 1 : 0, __LINE__);
+			if(!subset)
+				refinedVectorValidated = false;
+		}
+
+		if(flowstar_audit_trace_enabled())
+		{
+			printf(
+				"FLOWSTAR_AUDIT step=%s "
+				"phase=refined_full_picard_revalidation subset=%d "
+				"action=%s source_line=%d\n",
+				flowstar_audit_step(), refinedVectorValidated ? 1 : 0,
+				refinedVectorValidated ? "keep_refined" :
+					"restore_initial_validated_remainder",
+				__LINE__);
+		}
+		if(!refinedVectorValidated)
+		{
+			for(unsigned int i=0; i<rangeDim; ++i)
+				x.tms[i].remainder = accepted_initial_remainders[i];
+		}
+	}
+
 	result.tmvPre = x;
 	result.domain = domain;
 	result.domain[0] = tm_setting.step_exp_table[1];
+	for(unsigned int i=0; i<rangeDim; ++i)
+	{
+		flowstar_audit_interval(
+			"final_native_returned_remainder", i,
+			result.tmvPre.tms[i].remainder, -1, 1, __LINE__);
+	}
+	if(flowstar_audit_trace_enabled())
+	{
+		printf(
+			"FLOWSTAR_AUDIT step=%s phase=advance_return reason=success "
+			"return_code=1 source_line=%d\n",
+			flowstar_audit_step(), __LINE__);
+	}
 
 	return 1;
 }
