+			}
+		}
+		else
+		{
+			bfinished = true;
+			for(unsigned int i=0; i<rangeDim; ++i)
+			{
+				if(newRemainders[i].subseteq(x.tms[i].remainder))
+				{
+					if(widthRatios[i] <= STOP_RATIO)
+						bfinished = false;
+					x.tms[i].remainder = newRemainders[i];
+				}
