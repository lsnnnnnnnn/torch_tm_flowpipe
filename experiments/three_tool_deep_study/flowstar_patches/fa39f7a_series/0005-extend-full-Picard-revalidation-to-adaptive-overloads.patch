+				Interval freshIntDifference;
+				freshPolyDifference.intEvalNormal(
+					freshIntDifference, tm_setting.step_exp_table);
+				freshIntDifferences.push_back(freshIntDifference);
+
+				fullPicard.tms[i].remainder += freshIntDifference;
+				if(!fullPicard.tms[i].remainder.subseteq(
+					proposedX.tms[i].remainder))
 				{
-					bfinished = false;
+					completeImageIsSubset = false;
 				}
