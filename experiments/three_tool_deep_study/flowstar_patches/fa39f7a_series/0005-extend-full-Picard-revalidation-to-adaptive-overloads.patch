+		if(flowstar_audit_revalidate_refinement())
+		{
+			if(!cachedProposalIsSubset)
 			{
-				if(x.tms[i].remainder.widthRatio(newRemainders[i]) <= STOP_RATIO)
+				bfinished = true;
+				break;
+			}
+
+			TaylorModelVec<Real> proposedX = x;
+			for(unsigned int i=0; i<rangeDim; ++i)
+				proposedX.tms[i].remainder = newRemainders[i];
+
+			TaylorModelVec<Interval> fullPicard;
+			std::list<Interval> freshIntermediateRanges;
+			proposedX.Picard_ctrunc_normal(
+				fullPicard, new_x0, ode, tm_setting.step_exp_table,
+				rangeDimExt, tm_setting.order, tm_setting.cutoff_threshold,
+				freshIntermediateRanges, g_setting);
+
+			std::vector<Interval> freshIntDifferences;
+			bool completeImageIsSubset = true;
+			for(unsigned int i=0; i<rangeDim; ++i)
+			{
+				Polynomial<Interval> freshPolyDifference;
+				freshPolyDifference =
+					fullPicard.tms[i].expansion -
