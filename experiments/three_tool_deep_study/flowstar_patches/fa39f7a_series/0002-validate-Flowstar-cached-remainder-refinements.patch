index 0000000..0d070a9
--- /dev/null
+++ b/tests/README.md
@@ -0,0 +1,18 @@
+# Refinement correctness regression
+
+Run:
+
+```bash
+./tests/run_refinement_revalidation.sh
+```
+
+The scalar Riccati case intentionally preserves the stock under-enclosure as
+audit evidence. The test then requires both experiment-local corrections to
+contain the analytic endpoint and requires every raw endpoint to remain inside
+its whole-segment tube:
+
+- `full_picard` regenerates and checks the complete Picard image before every
+  proposed refined remainder is accepted.
+- `root_cause` records the interval generated when an expression variable is
+  degree-truncated and replays that interval in the cached remainder-only
+  evaluator.
diff --git a/tests/refinement_revalidation_riccati.cpp b/tests/refinement_revalidation_riccati.cpp
new file mode 100644
index 0000000..836201f
--- /dev/null
+++ b/tests/refinement_revalidation_riccati.cpp
@@ -0,0 +1,92 @@
+#include "Continuous.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+using namespace flowstar;
+using namespace std;
+
+static vector<Real> endpoint_powers(
+	const Interval & time_domain, const unsigned int order)
+{
+	Real h;
+	time_domain.sup(h);
+	vector<Real> powers(order + 1, 1);
+	for(unsigned int i = 1; i <= order; ++i)
+		powers[i] = powers[i-1] * h;
+	return powers;
+}
+
+int main(int argc, char ** argv)
+{
+	const string mode = argc > 1 ? argv[1] : "stock";
+	unsetenv("FLOWSTAR_AUDIT_REVALIDATE_REFINEMENT");
+	unsetenv("FLOWSTAR_AUDIT_CACHE_LEAF_TRUNCATION");
+	if(mode == "full_picard")
+		setenv("FLOWSTAR_AUDIT_REVALIDATE_REFINEMENT", "1", 1);
+	else if(mode == "root_cause")
+		setenv("FLOWSTAR_AUDIT_CACHE_LEAF_TRUNCATION", "1", 1);
+	else if(mode != "stock")
+		return 64;
+
+	Variables vars;
+	const int x_id = vars.declareVar("x");
+	ODE<Real> ode({"x^2"}, vars);
+	Computational_Setting setting(vars);
+	if(!setting.setFixedStepsize(0.01, 2))
+		return 65;
+	setting.setCutoffThreshold(1e-15);
+	setting.setRemainderEstimation(
+		vector<Interval>(vars.size(), Interval(-1e-4, 1e-4)));
+	setting.printOff();
+
+	vector<Interval> initial_box(vars.size());
+	initial_box[x_id] = Interval(0.0, 0.1);
+	Flowpipe current(initial_box);
+	Flowpipe next;
+	vector<Constraint> invariant;
+	const int advanced = current.advance(
+		next, ode.expressions, setting.tm_setting, invariant, setting.g_setting);
+	if(advanced != 1)
+		return 66;
+
+	TaylorModelVec<Real> composed;
+	next.compose(
+		composed, setting.tm_setting.order,
+		setting.tm_setting.cutoff_threshold);
+	vector<Interval> tube;
+	composed.intEval(tube, next.domain);
+
+	TaylorModelVec<Real> endpoint;
+	composed.evaluate_time(
+		endpoint,
+		endpoint_powers(next.domain[0], setting.tm_setting.order));
+	vector<Interval> endpoint_domain = next.domain;
+	endpoint_domain[0] = Interval(0.0);
+	vector<Interval> endpoint_box;
+	endpoint.intEval(endpoint_box, endpoint_domain);
+
+	const double exact_lower = 0.0;
+	const double exact_upper = 0.1 / (1.0 - 0.1 * 0.01);
+	const bool analytic_contained =
+		endpoint_box[0].inf() <= exact_lower &&
+		endpoint_box[0].sup() >= exact_upper;
+	const bool endpoint_in_tube =
+		tube[0].inf() <= endpoint_box[0].inf() &&
+		tube[0].sup() >= endpoint_box[0].sup();
+	printf(
+		"mode=%s endpoint=[%.17g,%.17g] tube=[%.17g,%.17g] "
+		"exact=[%.17g,%.17g] analytic_contained=%d endpoint_in_tube=%d\n",
+		mode.c_str(), endpoint_box[0].inf(), endpoint_box[0].sup(),
+		tube[0].inf(), tube[0].sup(), exact_lower, exact_upper,
+		analytic_contained ? 1 : 0, endpoint_in_tube ? 1 : 0);
+
+	if(!endpoint_in_tube)
+		return 67;
+	if(mode == "stock")
+		return analytic_contained ? 68 : 0;
+	return analytic_contained ? 0 : 69;
+}
