+// Experiment-local switch for the minimal cached-remainder correctness patch.
+// The full evaluator truncates a variable Taylor model to the RHS order before
+// using it.  Upstream's remainder-only replay returned only the variable's
+// pre-existing remainder and therefore omitted the remainder generated by that
+// leaf truncation.  Keep stock behavior available unless explicitly requested.
+inline bool flowstar_cache_leaf_truncation_enabled()
+{
+	const char * value = std::getenv("FLOWSTAR_AUDIT_CACHE_LEAF_TRUNCATION");
+	return value != NULL && value[0] != '\0' && value[0] != '0';
+}
