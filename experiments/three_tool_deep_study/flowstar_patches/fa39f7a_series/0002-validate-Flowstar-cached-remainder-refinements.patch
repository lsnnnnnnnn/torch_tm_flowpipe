+#!/usr/bin/env bash
+set -euo pipefail
+
+HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+ROOT="$(cd "$HERE/.." && pwd)"
+BUILD_DIR="$(mktemp -d /tmp/flowstar_refinement_regression.XXXXXX)"
+trap 'rm -rf "$BUILD_DIR"' EXIT
+
+make -C "$ROOT/flowstar-toolbox" -j4
+g++ -O3 -w -fpermissive -std=c++11 \
+  -I "$ROOT/flowstar-toolbox" \
+  "$HERE/refinement_revalidation_riccati.cpp" \
+  -L "$ROOT/flowstar-toolbox" \
+  -o "$BUILD_DIR/refinement_revalidation_riccati" \
+  -lflowstar -lmpfr -lgmp -lgsl -lgslcblas -lm -lglpk
+
+"$BUILD_DIR/refinement_revalidation_riccati" stock
+"$BUILD_DIR/refinement_revalidation_riccati" full_picard
+"$BUILD_DIR/refinement_revalidation_riccati" root_cause
