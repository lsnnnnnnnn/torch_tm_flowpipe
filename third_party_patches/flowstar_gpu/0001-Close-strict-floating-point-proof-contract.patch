+def test_dense_and_sparse_retained_coefficients_enclose_exact_rationals() -> None:
+    """Independent convolution oracle covers mixed signs/exponents/zero."""
+    tables = build_tables(2, 3)
+    values_a = [
+        1.0000000000000002, -1.0, 2.0**1020, 2.0**-500,
+        5e-324, -0.0, 0.5, -0.25, 3.0, -2.0,
+    ]
+    values_b = [
+        0.9999999999999999, 1.0, 2.0**-500, -2.0**-500,
+        1.0, 0.0, -0.5, 0.25, -3.0, 2.0,
+    ]
+    a = torch.tensor([values_a[: tables.Ts]], dtype=torch.float64)
+    b = torch.tensor([values_b[: tables.Ts]], dtype=torch.float64)
+    dense_point, dense_range = poly.mul_point_spatial_with_roundoff(a, b, tables)
+    dense_exact_iv = poly.mul_iv_spatial(iv.from_point(a), iv.from_point(b), tables)
+
+    step = build_step_tables(tables, 0.01)
+    engine = sparse.SparseEngine(tables, step, "cpu")
+    factor_support = sparse.full_support(tables, tables.k, spatial=True)
+    pair = engine.pair(factor_support, factor_support)
+    sparse_point, sparse_range = sparse.mul_point_s_with_roundoff(
+        a, b, pair, engine
+    )
+    sparse_exact_iv = sparse.mul_iv_s(iv.from_point(a), iv.from_point(b), pair)
+
+    assert torch.equal(dense_point, sparse_point)
+    assert torch.equal(dense_range, sparse_range)
+    assert torch.equal(dense_exact_iv, sparse_exact_iv)
+    offsets = pair.seg_offsets.cpu().tolist()
+    ia = pair.pair_ia.cpu().tolist()
+    jb = pair.pair_jb.cpu().tolist()
+    for output in range(pair.sup_out.size):
+        exact = sum(
+            (
+                Fraction(a[0, ia[p]].item()) * Fraction(b[0, jb[p]].item())
+                for p in range(offsets[output], offsets[output + 1])
+            ),
+            Fraction(),
+        )
+        assert Fraction(dense_exact_iv[0, output, 0].item()) <= exact
+        assert exact <= Fraction(dense_exact_iv[0, output, 1].item())
+        point = Fraction(dense_point[0, output].item())
+        error = exact - point
+        coeff_error = iv.sub(
+            dense_exact_iv[:, output], iv.from_point(dense_point[:, output])
+        )
+        assert Fraction(coeff_error[0, 0].item()) <= error
+        assert error <= Fraction(coeff_error[0, 1].item())
