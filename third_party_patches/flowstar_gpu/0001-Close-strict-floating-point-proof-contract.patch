+@pytest.mark.parametrize("relation", ["below", "equal", "above"])
+def test_refinement_stop_ratio_boundary_is_recorded(monkeypatch, relation: str) -> None:
+    import flowstar_gpu.flowpipe as fp
+
+    proposal = torch.tensor([[[-0.5, 0.5]]], dtype=torch.float64)
+    monkeypatch.setattr(fp, "exec_replay", lambda *_args, **_kwargs: proposal.clone())
+    accepted = torch.tensor([[[-1.0, 1.0]]], dtype=torch.float64)
+    replayed = iv.mul(proposal, torch.tensor([1.0, 1.0], dtype=torch.float64))
+    replayed = iv.add(replayed, torch.zeros_like(replayed))
+    ratio = float((iv.width(replayed) / iv.width(accepted)).item())
+    threshold = {
+        "below": math.nextafter(ratio, math.inf),
+        "equal": ratio,
+        "above": math.nextafter(ratio, -math.inf),
+    }[relation]
+    trace = []
+    settings = Settings(
+        step=1.0, order=2, device="cpu", max_refinement_steps=1,
+        stop_ratio=threshold, refinement_callback=trace.append,
+    )
+    refine_loop(
+        object(), accepted, torch.tensor([True]), torch.tensor([False]),
+        torch.zeros(1, 1, 2), torch.zeros(1, 1, 2), False,
+        torch.zeros_like(accepted), _UnitStep(), settings,
+    )
+    component = [row for row in trace if row["event"] == "refinement_component"][0]
+    assert component["stop_ratio_inputs"]["ratio"] == ratio
+    assert component["stop_decision"] is (relation != "above")
