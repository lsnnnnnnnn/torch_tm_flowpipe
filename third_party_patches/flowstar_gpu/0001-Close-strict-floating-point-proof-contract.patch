+def test_refinement_trace_owns_partial_commit_and_detects_stale_cache(monkeypatch) -> None:
+    import flowstar_gpu.flowpipe as fp
+
+    proposal = torch.tensor([[[-0.5, 0.5], [-2.0, 2.0]]], dtype=torch.float64)
+    monkeypatch.setattr(fp, "exec_replay", lambda *_args, **_kwargs: proposal.clone())
+    accepted = torch.tensor([[[-1.0, 1.0], [-1.0, 1.0]]], dtype=torch.float64)
+    ok = torch.tensor([True])
+    bad = torch.tensor([False])
+    cache = torch.zeros(1, 1, 2, dtype=torch.float64)
+    tails = torch.zeros(1, 1, 2, dtype=torch.float64)
+    trace = []
+    settings = Settings(
+        step=1.0,
+        order=2,
+        device="cpu",
+        max_refinement_steps=1,
+        refinement_callback=trace.append,
+    )
+    state = RefinementCacheState("cache", "tails", 0, accepted.clone(), accepted.clone())
+    cur, bad_out = refine_loop(
+        object(), accepted, ok, bad, cache, tails, False,
+        torch.zeros_like(accepted), _UnitStep(), settings, cache_state=state,
+    )
+    assert not bool(bad_out.item())
+    components = [row for row in trace if row["event"] == "refinement_component"]
+    assert [row["commit_result"] for row in components] == [True, False]
+    assert cur[0, 0].tolist() == components[0]["proposal_interval"]
+    assert torch.equal(cur[0, 1], accepted[0, 1])
+    final = [row for row in trace if row["event"] == "final_remainder_owner"][-1]
+    assert final["final_accepted_remainder"] == cur[0].tolist()
+    assert final["final_generation"] == 1
+
+    stale = RefinementCacheState("cache", "tails", 9, accepted.clone(), accepted.clone())
+    with pytest.raises(RuntimeError, match="stale refinement cache generation"):
+        refine_loop(
+            object(), accepted, ok, bad, cache, tails, False,
+            torch.zeros_like(accepted), _UnitStep(), settings, cache_state=stale,
+        )
+
+    stale_owner = RefinementCacheState(
+        "cache", "tails", 0, accepted + 1.0, accepted.clone()
+    )
+    with pytest.raises(RuntimeError, match="stale refinement cache owner"):
+        refine_loop(
+            object(), accepted, ok, bad, cache, tails, False,
+            torch.zeros_like(accepted), _UnitStep(), settings,
+            cache_state=stale_owner,
+        )
+
