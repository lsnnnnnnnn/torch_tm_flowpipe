+    exact_coeff = poly.mul_iv_spatial(iv.from_point(a), iv.from_point(b), tables)
+    coeff_error = iv.sub(exact_coeff, iv.from_point(point))
+    reranged = poly.range_normal_iv_spatial(coeff_error, tables)
+    assert torch.equal(error_range, reranged)
+    assert bool(iv.contains(error_range, torch.zeros_like(error_range)).all())
