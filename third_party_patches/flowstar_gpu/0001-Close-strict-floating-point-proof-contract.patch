+def test_spatial_point_product_is_unchanged_and_roundoff_is_enclosed() -> None:
+    tables = build_tables(1, 4)
+    a = torch.tensor([[1.0000000000000002, -1.0, 2.0**-20, 0.0, 0.0]], dtype=torch.float64)
+    b = torch.tensor([[0.9999999999999999, 1.0, -(2.0**20), 0.0, 0.0]], dtype=torch.float64)
